{
  "compilerOptions": {
    "outDir": "./build",
    "rootDir": "src",
    "baseUrl": "src",
    "paths": {
      "@": ["./src"],
      "~/*": ["./src/*"]
    },
    "allowJs": true,
    "strict": true,
    "strictNullChecks": true,
    "pretty": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "incremental": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "Node",
    "target": "ES6",
    "moduleDetection": "force"
  }, 
  "include": ["./src"],
  "exclude": ["build", "node_modules"],
}