// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  @@map("users")
  id String @id @db.Uuid @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  username String? @unique
  email String @unique
  matches Match[]
  follows Follow[] @relation(name: "follows")
  followers Follow[] @relation(name: "followers")
}

model Match {
  @@map("matches")
  id String @id @db.Uuid @default(uuid())
  user User @relation(fields: [userId], references: [id])
  userId String @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  type String
  userScore Int
  userPossession Float?
  userXG Float?
  userShots Int?
  userPenalties Int?
  opponentScore Int?
  opponentXG Float?
  opponentShots Int?
  opponentPenalties Int?
  userYellows Int?
  userReds Int?
  minutes Int?
}

model Follow {
  @@map("follows")
  id String @id @db.Uuid @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(name: "follows", fields: [userId], references: [id])
  userId String @db.Uuid
  followedUser User @relation(name: "followers", fields: [followedUserId], references: [id])
  followedUserId String @db.Uuid
}