{
  "name": "egolf-tracker-api",
  "version": "0.0.2",
  "description": "API for Track Golf",
  "author": "Cormac Williamson",
  "scripts": {
    "dev:server": "sls offline start --stage offline",
    "dev": "run-p dev:*",
    "tail-log": "sls logs -f app -t",
    "deploy:dev": "sls deploy --stage dev",
    "deploy:prod": "sls deploy --stage prod",
    "deploy-prod": "run-s deploy:*",
    "remove-prod": "cross-env NODE_ENV=production sls remove --stage prod",
    "clean": "rimraf dist .esbuild .serverless",
    "lint": "eslint .",
    "format": "eslint --fix . && prettier '**/*.{json,yaml}' --write --ignore-path .gitignore",
    "check-types": "tsc --noEmit --pretty",
    "commit": "cz",
    "test": "jest",
    "test:dev": "start-server-and-test dev http://127.0.0.1:4000 'curl --head http://127.0.0.1:4000'",
    "prepare": "husky install"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.705.0",
    "@aws-sdk/lib-dynamodb": "3.704.0",
    "@types/cors": "^2.8.17",
    "cors": "^2.8.5",
    "dynamodb-toolbox": "^1.15.5",
    "express": "^4.19.1",
    "express-async-errors": "^3.1.1",
    "helmet": "^7.1.0",
    "serverless-http": "^3.2.0",
    "supertokens-node": "^21.1.0",
    "uuid": "^11.0.5",
    "winston": "^3.17.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.2.1",
    "@commitlint/config-conventional": "^19.1.0",
    "@commitlint/cz-commitlint": "^19.2.0",
    "@swc/core": "^1.4.8",
    "@swc/jest": "^0.2.36",
    "@types/cross-spawn": "^6.0.6",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^7.3.1",
    "@typescript-eslint/parser": "^7.3.1",
    "commitizen": "^4.3.0",
    "cross-spawn": "^7.0.3",
    "dotenv-cli": "^7.4.1",
    "esbuild": "~0.16.17",
    "eslint": "^8.57.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-airbnb-typescript": "^18.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jest": "^27.9.0",
    "eslint-plugin-jest-formatting": "^3.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-simple-import-sort": "^12.0.0",
    "eslint-plugin-unused-imports": "^3.1.0",
    "husky": "^9.0.11",
    "jest": "^29.7.0",
    "lint-staged": "^15.2.2",
    "npm-run-all": "^4.1.5",
    "p-retry": "^4.6.2",
    "prettier": "^3.2.5",
    "rimraf": "^5.0.5",
    "serverless": "^3.38.0",
    "serverless-dotenv-plugin": "^6.0.0",
    "serverless-esbuild": "^1.52.1",
    "serverless-offline": "^13.3.3",
    "start-server-and-test": "^2.0.3",
    "supertest": "^6.3.4",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.7.1",
    "typescript": "^5.4.3"
  },
  "config": {
    "commitizen": {
      "path": "@commitlint/cz-commitlint"
    }
  }
}