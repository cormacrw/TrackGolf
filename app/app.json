{
  "name": "TrackUT",
  "displayName": "TrackUT",
  "expo": {
    "name": "TrackUT",
    "slug": "TrackUT",
    "scheme": "trackut",
    "version": "0.0.2",
    "orientation": "portrait",
    "icon": "./assets/images/icon-all.png",
    "splash": {
      "image": "./assets/images/icon-large.png",
      "resizeMode": "contain",
      "backgroundColor": "#1E1F23"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "jsEngine": "hermes",
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "icon": "./assets/images/icon-512-small.png",
      "package": "com.trackut",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon-512-small.png",
        "backgroundImage": "./assets/images/app-icon-android-adaptive-background.png"
      },
      "splash": {
        "image": "./assets/images/icon-large.png",
        "resizeMode": "contain",
        "backgroundColor": "#1E1F23"
      }
    },
    "ios": {
      "icon": "./assets/images/icon-all.png",
      "supportsTablet": false,
      "bundleIdentifier": "com.trackut",
      "splash": {
        "image": "./assets/images/icon-large.png",
        "resizeMode": "contain",
        "backgroundColor": "#1E1F23"
      }
    },
    "plugins": [
      "expo-localization",
      [
        "expo-build-properties",
        {
          "ios": {
            "newArchEnabled": false
          },
          "android": {
            "newArchEnabled": false
          }
        }
      ]
    ],
    "experiments": {
      "tsconfigPaths": true
    },
    "extra": {
      "eas": {
        "projectId": "95b1ee72-16ca-4470-af20-fd9a82dff379"
      }
    }
  },
  "ignite": {
    "version": "9.4.0"
  }
}